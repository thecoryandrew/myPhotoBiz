@model MyPhotoBiz.ViewModels.ContractTemplateListViewModel

@{
    ViewBag.Title = "Contract Templates";
    ViewBag.PageTitle = "Contract Template Library";
    ViewBag.Icon = "ti-file-text";
    ViewBag.Color = "info";
    ViewBag.ActionUrl = Url.Action("Create", "ContractTemplates");
    ViewBag.ActionText = "New Template";
    ViewBag.ActionIcon = "ti-plus";
}

<div class="container-fluid">
    <partial name="Partials/_PageTitle" />

    <div class="card">
        <div class="card-header">
            <h4 class="card-title mb-0">Available Templates</h4>
        </div>
        <div class="card-body">
            @if (Model.Templates.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Status</th>
                                <th>Created Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var template in Model.Templates)
                            {
                                <tr>
                                    <td>
                                        <strong>@template.Name</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary">@template.Category</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(template.Description))
                                        {
                                            @(template.Description.Length > 100 ? template.Description.Substring(0, 100) + "..." : template.Description)
                                        }
                                        else
                                        {
                                            <span class="text-muted">No description</span>
                                        }
                                    </td>
                                    <td>
                                        @if (template.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>@template.CreatedDate.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@template.Id" class="btn btn-sm btn-outline-primary" title="View Details">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@template.Id" class="btn btn-sm btn-outline-warning" title="Edit">
                                                <i class="ti ti-edit"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@template.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this template?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                                    <i class="ti ti-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="ti ti-info-circle me-2"></i>
                    <strong>No templates found.</strong> Create your first contract template to get started!
                </div>
            }
        </div>
    </div>
</div>
