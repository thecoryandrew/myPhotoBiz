@model MyPhotoBiz.ViewModels.ContractTemplateDetailsViewModel

@{
    ViewBag.Title = "Template Details";
    ViewBag.PageTitle = Model.Template.Name;
    ViewBag.Icon = "ti-file-text";
    ViewBag.Color = "info";
}

<div class="container-fluid">
    <partial name="Partials/_PageTitle" />

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title mb-0">Template Details</h4>
                    <div>
                        @if (Model.Template.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactive</span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">@Model.Template.Name</dd>

                        <dt class="col-sm-3">Category</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-primary">@Model.Template.Category</span>
                        </dd>

                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">
                            @if (!string.IsNullOrEmpty(Model.Template.Description))
                            {
                                @Model.Template.Description
                            }
                            else
                            {
                                <span class="text-muted">No description provided</span>
                            }
                        </dd>

                        <dt class="col-sm-3">Created Date</dt>
                        <dd class="col-sm-9">@Model.Template.CreatedDate.ToString("MMMM dd, yyyy")</dd>

                        @if (Model.Template.UpdatedDate.HasValue)
                        {
                            <dt class="col-sm-3">Last Updated</dt>
                            <dd class="col-sm-9">@Model.Template.UpdatedDate.Value.ToString("MMMM dd, yyyy")</dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.Template.CreatedBy))
                        {
                            <dt class="col-sm-3">Created By</dt>
                            <dd class="col-sm-9">@Model.Template.CreatedBy</dd>
                        }
                    </dl>

                    <hr />

                    <h5>Template Content</h5>
                    <div class="border rounded p-3 bg-light" style="white-space: pre-wrap;">@Model.Template.Content</div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-action="Edit" asp-route-id="@Model.Template.Id" class="btn btn-warning">
                            <i class="ti ti-edit me-1"></i> Edit Template
                        </a>

                        <form asp-action="ToggleStatus" asp-route-id="@Model.Template.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn @(Model.Template.IsActive ? "btn-secondary" : "btn-success")">
                                <i class="ti @(Model.Template.IsActive ? "ti-x" : "ti-check") me-1"></i>
                                @(Model.Template.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>

                        <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#duplicateModal">
                            <i class="ti ti-copy me-1"></i> Duplicate
                        </button>

                        <form asp-action="Delete" asp-route-id="@Model.Template.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this template? This action cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="ti ti-trash me-1"></i> Delete
                            </button>
                        </form>

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="ti ti-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="ti ti-info-circle me-2"></i>Template Information
                    </h5>
                </div>
                <div class="card-body">
                    <p><strong>Placeholders in Use</strong></p>
                    <p class="text-muted small">This template uses the following dynamic fields:</p>
                    <ul class="small">
                        @if (Model.Template.Content.Contains("{ClientFullName}"))
                        {
                            <li><code>{ClientFullName}</code></li>
                        }
                        @if (Model.Template.Content.Contains("{ClientFirstName}"))
                        {
                            <li><code>{ClientFirstName}</code></li>
                        }
                        @if (Model.Template.Content.Contains("{ClientLastName}"))
                        {
                            <li><code>{ClientLastName}</code></li>
                        }
                        @if (Model.Template.Content.Contains("{ClientEmail}"))
                        {
                            <li><code>{ClientEmail}</code></li>
                        }
                        @if (Model.Template.Content.Contains("{ClientPhone}"))
                        {
                            <li><code>{ClientPhone}</code></li>
                        }
                        @if (Model.Template.Content.Contains("{ClientAddress}"))
                        {
                            <li><code>{ClientAddress}</code></li>
                        }
                        @if (Model.Template.Content.Contains("{CurrentDate}"))
                        {
                            <li><code>{CurrentDate}</code></li>
                        }
                        @if (Model.Template.Content.Contains("{CurrentYear}"))
                        {
                            <li><code>{CurrentYear}</code></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Duplicate Modal -->
<div class="modal fade" id="duplicateModal" tabindex="-1" aria-labelledby="duplicateModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Duplicate" asp-route-id="@Model.Template.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="duplicateModalLabel">Duplicate Template</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newName" class="form-label">New Template Name</label>
                        <input type="text" class="form-control" id="newName" name="newName" value="@Model.Template.Name (Copy)" required />
                    </div>
                    <p class="text-muted small">This will create a new template with the same content as "@Model.Template.Name".</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Duplicate</button>
                </div>
            </form>
        </div>
    </div>
</div>
