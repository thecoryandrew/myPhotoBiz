@model MyPhotoBiz.ViewModels.CreateContractTemplateViewModel

@{
    ViewBag.Title = "Create Contract Template";
    ViewBag.PageTitle = "Create Contract Template";
    ViewBag.Icon = "ti-file-plus";
    ViewBag.Color = "success";
}

<div class="container-fluid">
    <partial name="Partials/_PageTitle" />

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title mb-0">Template Information</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g., Wedding Photography Contract" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label"></label>
                            <select asp-for="Category" asp-items="Model.CategoryOptions" class="form-select">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Brief description of this template"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Content" class="form-label"></label>
                            <textarea asp-for="Content" class="form-control" rows="15" placeholder="Enter contract content here. Use placeholders like {ClientFullName}, {ClientEmail}, {ClientPhone}, {ClientAddress}, {CurrentDate}"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                            <small class="form-text text-muted">
                                Available placeholders: {ClientFirstName}, {ClientLastName}, {ClientFullName}, {ClientEmail}, {ClientPhone}, {ClientAddress}, {CurrentDate}, {CurrentYear}
                            </small>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-check me-1"></i> Create Template
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="ti ti-x me-1"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="ti ti-info-circle me-2"></i>Template Tips
                    </h5>
                </div>
                <div class="card-body">
                    <p><strong>Use Placeholders</strong></p>
                    <p class="text-muted small">Add dynamic fields that will be auto-populated with client information:</p>
                    <ul class="small text-muted">
                        <li><code>{ClientFullName}</code> - Client's full name</li>
                        <li><code>{ClientEmail}</code> - Client's email</li>
                        <li><code>{ClientPhone}</code> - Client's phone</li>
                        <li><code>{ClientAddress}</code> - Client's address</li>
                        <li><code>{CurrentDate}</code> - Today's date</li>
                        <li><code>{CurrentYear}</code> - Current year</li>
                    </ul>

                    <hr class="my-3" />

                    <p><strong>Categories</strong></p>
                    <p class="text-muted small">Organize templates by photography type for easy access.</p>

                    <hr class="my-3" />

                    <p><strong>Template Status</strong></p>
                    <p class="text-muted small">Inactive templates won't appear when creating new contracts.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
